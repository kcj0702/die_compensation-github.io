data/raw/*
data/sample/*
data/intermediate/*
data/output/*
# 등록된 제품데이터 이미지와 품번별 확정 정렬은 회사 자료라 커밋하지 않는다.
data/product/*
data/alignment/*
# CATIA .CATPart 원본과 그로부터 캐시된 STEP 도 회사 자료 — 절대 커밋 금지.
data/product_mesh/*
# 사내 보정시트 엑셀 양식도 마찬가지다.
data/template/*

!data/raw/.gitkeep
!data/sample/.gitkeep
!data/intermediate/.gitkeep
!data/output/.gitkeep
!data/product/.gitkeep
!data/alignment/.gitkeep
!data/product_mesh/.gitkeep
!data/template/.gitkeep

__pycache__/
*.py[cod]
.venv/
AJ_ENV/
.pytest_cache/

# CAD sources are company data: never commit STP/STEP/CATPart anywhere in the tree, whatever folder
# they are copied into for local checks (the logic that reads them is committed, the files are not).
*.stp
*.STP
*.step
*.STEP
*.stpZ
*.CATPart
*.catpart
*.CATPRODUCT
*.CATProduct
*.stl
*.STL

# Local backups created while separating review work from commit-ready code
.local_archive/

# Keep the zero-line review source visible while excluding generated previews
experiments/*
!experiments/zero_line_area_edge_preview/
experiments/zero_line_area_edge_preview/results*/
experiments/zero_line_area_edge_preview/__pycache__/
experiments/zero_line_area_edge_preview/*.zip

# Company scan inputs and generated label-removal results
label_removal/input/*
label_removal/output/*

!label_removal/input/.gitkeep
!label_removal/output/.gitkeep

# AJIN Die Insight file-organizer runtime data
ui/backend/file_staging/
ui/backend/file_operation_logs/
ui/.env
ui/backend/.label_cache.json
cad_import/_parsed/
zero_line_detection/.lab_cache/

# 관리면 엔진: 등록된 관리 CATPart 원본과 CATIA 추출 캐시(IGES·manifest·STEP)는 회사 자료 — 커밋 금지.
data/management_surface/*
data/.management_overlay_cache/
# 검토용 산출물(CLAUDE.md §0-3)은 로컬에서만 본다.
outputs/
